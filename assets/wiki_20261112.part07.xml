</text></revision></page><page><title>Модуль:Парламент Кефирстана</title><ns>828</ns><revision><timestamp>2026-11-12T22:04:14Z</timestamp><contributor><username>AureliaWikiImport</username></contributor><model>Scribunto</model><format>text/plain</format><text xml:space="preserve" bytes="6616">local p = {}
local parties = {
    {key = 'ЛПК', color = '#F2C230', page = 'Либертарианская Партия Кефирстана'},
    {key = 'НПК', color = '#D44848', page = 'Народная Партия Кефирстана'},
