.mw-parser-output .aurelia-path a { color:var(--aur-muted); }
.mw-parser-output .aurelia-path .separator { padding:0 8px; }
.mw-parser-output .aurelia-topics { display:flex; flex-wrap:wrap; gap:8px 22px; padding:13px 0; margin:8px 0 24px;  font-family:inherit; font-size:14px; }
.mw-parser-output .aurelia-topics p { display:contents; font:inherit; }
.mw-parser-output .aurelia-country-nav { display:flex; flex-wrap:wrap; gap:6px 20px; padding:10px 0; margin:0 0 22px;  font-family:inherit; font-size:14px; }
.mw-parser-output .aurelia-country-nav p { display:contents; }
.mw-parser-output .aurelia-world-nav { clear:both; display:flex; flex-wrap:wrap; gap:8px 22px; padding:20px 0 6px; margin-top:38px;  font:13px/1.6 inherit; }
.mw-parser-output .aurelia-world-nav p { display:contents; font:inherit; }
.mw-parser-output .aurelia-home { max-width:1120px; margin:auto; }
.mw-parser-output .aurelia-hero { padding:8px 0 8px; }
.mw-parser-output .aurelia-wordmark { font-family:inherit; font-size:clamp(42px,7vw,76px); font-weight:400; line-height:1.12; margin:0 0 15px; letter-spacing:-.035em; color:var(--aur-text); }
.mw-parser-output .aurelia-intro { max-width:720px; font:18px/1.7 inherit; color:var(--aur-muted); }
.mw-parser-output .aurelia-map { margin:12px 0 8px; }
.mw-parser-output .aurelia-map img { width:100%; height:auto; display:block; }
.mw-parser-output .aurelia-map-caption { font:12px/1.6 inherit; color:var(--aur-muted); padding-top:8px; }
.mw-parser-output .aurelia-home-columns { display:grid; grid-template-columns:minmax(0,1.8fr) minmax(230px,1fr); gap:36px; margin-top:22px; }
.mw-parser-output .aurelia-country-list { columns:3 180px; column-gap:26px; margin:0; padding:0; list-style:none; }
.mw-parser-output .aurelia-country-list li { break-inside:avoid; margin:0; padding:9px 0; font:15px/1.5 inherit; }
.mw-parser-output .aurelia-country-list img { width:25px; height:17px; object-fit:contain; margin-right:8px; vertical-align:middle; }
.mw-parser-output .aurelia-index { margin:0 0 22px; padding:0; list-style:none; }
.mw-parser-output .aurelia-index li { padding:10px 0 12px;  }
.mw-parser-output .aurelia-index li &gt; a { font-size:17px; font-weight:600; }
.mw-parser-output .aurelia-index small { display:block; margin-top:4px; color:var(--aur-muted); font:13px/1.6 inherit; }
.mw-parser-output .aurelia-link-list { columns:3 210px; column-gap:28px; }
.mw-parser-output .aurelia-link-list li { break-inside:avoid; padding:4px 0; }
.mw-parser-output .aurelia-table-scroll { overflow-x:auto; max-width:100%; margin:1em 0; overscroll-behavior-inline:contain; }
.mw-parser-output table.wikitable { background:var(--aur-panel); color:var(--aur-text); border:1px solid var(--aur-line); border-collapse:collapse; font:14px/1.6 inherit; margin:0; }
.mw-parser-output table.wikitable th { background:var(--aur-raised); color:var(--aur-text); font-weight:600; text-align:left; }
.mw-parser-output table.wikitable td,.mw-parser-output table.wikitable th { border:1px solid var(--aur-line); padding:9px 12px; vertical-align:top; }
.mw-parser-output table.wikitable tr:hover td { background:rgba(184,213,173,.035); }
.mw-parser-output table.wikitable td { font-variant-numeric:tabular-nums; }
.mw-parser-output .toc { background:var(--aur-panel); border:1px solid var(--aur-line); padding:16px 20px; max-width:100%; font:14px/1.7 inherit; }
.mw-parser-output .toc ul { margin-left:1em; }
.mw-parser-output blockquote {  margin:1.2em 0 1.2em 12px; padding:4px 0 4px 18px; color:var(--aur-muted); }
.mw-parser-output .portable-infobox.pi-theme-aurelia { float:right; width:320px; max-width:100%; margin:0 0 24px 28px; background:var(--aur-panel); border:1px solid var(--aur-line);  color:var(--aur-text); font:14px/1.55 inherit; box-shadow:none; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-title { background:var(--aur-raised); color:var(--aur-text); font:600 21px/1.3 inherit; padding:17px 15px; text-align:center; margin:0; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-header { background:var(--aur-raised); color:var(--aur-muted); font-size:12px; font-weight:600; padding:10px 13px; border-color:var(--aur-line); }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-data { padding:10px 13px; border-color:var(--aur-line); background:transparent; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-data-label { flex-basis:42%; color:var(--aur-muted); font-size:12px; font-weight:400; padding-right:12px; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-data-value { flex-basis:58%; font-size:13px; overflow-wrap:anywhere; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-image { padding:14px; background:transparent; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-image-thumbnail { max-height:220px; width:auto; max-width:100%; object-fit:contain; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-image-caption { color:var(--aur-muted); font-size:11px; }
.mw-parser-output .aurelia-home h2 { font:400 27px/1.3 inherit; }
@media(max-width:900px) {
 .mw-parser-output .aurelia-home-columns { grid-template-columns:1fr; gap:4px; }
 .mw-parser-output .aurelia-country-list { columns:3 160px; }
}
@media(max-width:700px) {
 .mw-parser-output p { font-size:16px; line-height:1.75; }
 .mw-parser-output .portable-infobox.pi-theme-aurelia { float:none; width:100%; margin:18px 0 24px; box-sizing:border-box; }
 .mw-parser-output .portable-infobox.pi-theme-aurelia .pi-title { font-size:22px; }
 .mw-parser-output .aurelia-intro { font-size:17px; }
 .mw-parser-output .aurelia-country-list { columns:2; column-gap:16px; }
 .mw-parser-output .aurelia-country-list li { font-size:14px; padding:10px 0; }
 .mw-parser-output .aurelia-topics { gap:10px 17px; }
 .mw-parser-output h2 { font-size:1.35em; }
 .mw-parser-output table.wikitable { font-size:13px; }
 .mw-parser-output table.wikitable td,.mw-parser-output table.wikitable th { padding:8px 10px; }
}
@media print {
 .mw-parser-output { color:#111; background:white; }
 .mw-parser-output a { color:#111; }
 .mw-parser-output .aurelia-world-nav,.mw-parser-output .aurelia-topics,.mw-parser-output .aurelia-path { display:none; }
 .mw-parser-output .aurelia-table-scroll { overflow:visible; }
 .mw-parser-output .portable-infobox.pi-theme-aurelia,.mw-parser-output table.wikitable { background:white; color:#111; border-color:#aaa; }
}
.mw-parser-output .aurelia-panel-grid { width:100%; border-spacing:14px; }
.mw-parser-output .aurelia-panel { vertical-align:top; border:0; padding:16px; background:var(--aur-panel); }
.mw-parser-output .aurelia-panel-title { font-weight:600; margin-bottom:8px; }
.mw-parser-output .aurelia-center { text-align:center; }
.mw-parser-output table.aurelia-legacy-infobox { float:right; width:320px; max-width:100%; margin:0 0 24px 28px;  }
.mw-parser-output table.aurelia-legacy-infobox caption { background:var(--aur-raised); color:var(--aur-text); font:600 21px/1.35 inherit; padding:14px; }
.mw-parser-output table.aurelia-legacy-infobox img { max-width:100%; height:auto; object-fit:contain; }
@media(max-width:700px) {
 .mw-parser-output table.aurelia-legacy-infobox { float:none; width:100%; margin:18px 0 24px; }
 .mw-parser-output .aurelia-panel { display:block; width:100%; margin:0 0 12px; }
 .mw-parser-output .aurelia-panel-grid { border-spacing:0; }
}

.mw-parser-output h2, .mw-parser-output h3, .mw-parser-output .aurelia-topics, .mw-parser-output .aurelia-country-nav, .mw-parser-output .aurelia-world-nav, .mw-parser-output .aurelia-index li { border:0; }
.mw-parser-output .portable-infobox.pi-theme-aurelia, .mw-parser-output table.aurelia-legacy-infobox { border:0; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-header { border:0; }

.portable-infobox .pi-data[data-source="нижняя_палата_схема"],
.portable-infobox .pi-data[data-source="верхняя_палата_схема"] {
 display:block;
}
.portable-infobox .pi-data[data-source="нижняя_палата_схема"] &gt; .pi-data-value,
.portable-infobox .pi-data[data-source="верхняя_палата_схема"] &gt; .pi-data-value {
 width:100%;
 flex-basis:100%;
}
.aurelia-parliament-block { width:100%; }
.aurelia-parliament-legend {
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:6px 10px;
 margin-top:12px;
 font-size:12px;
 line-height:1.45;
}
.aurelia-parliament-party { display:flex; align-items:center; gap:5px; min-width:0; }
.aurelia-parliament-party &gt; b { margin-left:auto; font-variant-numeric:tabular-nums; }
.aurelia-parliament-marker { display:inline-block; width:8px; height:8px; border-radius:50%; flex-shrink:0; }
