 .mw-parser-output .aurelia-world-nav,.mw-parser-output .aurelia-topics,.mw-parser-output .aurelia-path { display:none; }
 .mw-parser-output .aurelia-table-scroll { overflow:visible; }
 .mw-parser-output .portable-infobox.pi-theme-aurelia,.mw-parser-output table.wikitable { background:white; color:#111; border-color:#aaa; }
}
.mw-parser-output .aurelia-panel-grid { width:100%; border-spacing:14px; }
.mw-parser-output .aurelia-panel { vertical-align:top; border:0; padding:16px; background:var(--aur-panel); }
.mw-parser-output .aurelia-panel-title { font-weight:600; margin-bottom:8px; }
.mw-parser-output .aurelia-center { text-align:center; }
.mw-parser-output table.aurelia-legacy-infobox { float:right; width:320px; max-width:100%; margin:0 0 24px 28px;  }
.mw-parser-output table.aurelia-legacy-infobox caption { background:var(--aur-raised); color:var(--aur-text); font:600 21px/1.35 inherit; padding:14px; }
.mw-parser-output table.aurelia-legacy-infobox img { max-width:100%; height:auto; object-fit:contain; }
@media(max-width:700px) {
 .mw-parser-output table.aurelia-legacy-infobox { float:none; width:100%; margin:18px 0 24px; }
 .mw-parser-output .aurelia-panel { display:block; width:100%; margin:0 0 12px; }
 .mw-parser-output .aurelia-panel-grid { border-spacing:0; }
}

.mw-parser-output h2, .mw-parser-output h3, .mw-parser-output .aurelia-topics, .mw-parser-output .aurelia-country-nav, .mw-parser-output .aurelia-world-nav, .mw-parser-output .aurelia-index li { border:0; }
.mw-parser-output .portable-infobox.pi-theme-aurelia, .mw-parser-output table.aurelia-legacy-infobox { border:0; }
.mw-parser-output .portable-infobox.pi-theme-aurelia .pi-header { border:0; }

.portable-infobox .pi-data[data-source="нижняя_палата_схема"],
.portable-infobox .pi-data[data-source="верхняя_палата_схема"] {
 display:block;
}
.portable-infobox .pi-data[data-source="нижняя_палата_схема"] &gt; .pi-data-value,
.portable-infobox .pi-data[data-source="верхняя_палата_схема"] &gt; .pi-data-value {
 width:100%;
 flex-basis:100%;
}
.aurelia-parliament-block { width:100%; }
.aurelia-parliament-legend {
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:6px 10px;
 margin-top:12px;
 font-size:12px;
 line-height:1.45;
}
.aurelia-parliament-party { display:flex; align-items:center; gap:5px; min-width:0; }
.aurelia-parliament-party &gt; b { margin-left:auto; font-variant-numeric:tabular-nums; }
.aurelia-parliament-marker { display:inline-block; width:8px; height:8px; border-radius:50%; flex-shrink:0; }
